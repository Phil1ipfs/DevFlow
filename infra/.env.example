# Copy to infra/.env (never commit the real file) and fill in.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Public URL of the web app, used in emailed links.
WEB_BASE_URL=http://localhost:3000

# Optional SMTP relay for password-reset and invitation emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@devflow.local
